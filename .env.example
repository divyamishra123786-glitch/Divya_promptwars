# BlindSpot AI — Environment Variables
# Copy this file to .env and fill in your values

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# In development, set to your Vite dev server URL
# In production, set to your deployed frontend domain (e.g. https://blindspot.vercel.app)
CLIENT_ORIGIN=http://localhost:5173

# ── Client (Vite) ─────────────────────────────────────────────────────────────
# Leave empty in dev (Vite proxy handles /api -> server)
# In production set to your backend URL (e.g. https://blindspot-api.onrender.com)
VITE_API_URL=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
ANALYZE_RATE_LIMIT_MAX=20
